{
  "description": "Collectible game where you raise, train, and battle cute little monsters in your homestead",
  "secrets": [],
  "governance": {
    "approvers": "invited",
    "approvals": {
      "atLeast": 1
    }
  },
  "tests": [
    {
      "id": "home.creature-count",
      "name": "Home shows the tagline and the wallet's Creature count out of 10",
      "path": "/",
      "expectSelector": "#creature-slots #creature-count",
      "expectText": "/ 10",
      "visual": true,
      "impact": [
        "public/**",
        "styles/**",
        "tailwind.config.js"
      ]
    },
    {
      "name": "The header shows CONNECT until a wallet connects",
      "path": "/",
      "expectSelector": "#wallet [data-action=\"connect\"]",
      "expectText": "CONNECT"
    },
    {
      "name": "Home shows Genesis with GENESIS MINT",
      "path": "/",
      "expectSelector": "#genesis [data-action=\"genesis-mint\"]",
      "expectText": "GENESIS MINT"
    },
    {
      "name": "Home's Genesis shows its cost in STEAD",
      "path": "/",
      "expectSelector": "#genesis [data-genesis-cost=\"5000\"]",
      "expectText": "5,000 STEAD"
    },
    {
      "name": "Home shows the Daily Check-in seven day schedule",
      "path": "/",
      "expectSelector": "#daily-check-in [data-check-in-day=\"7\"]",
      "expectText": "DAILY CHECK-IN"
    },
    {
      "name": "My Creature placeholder",
      "path": "/creature",
      "expectSelector": "[data-empty=\"creature\"]",
      "expectText": "No Creature yet."
    },
    {
      "name": "Homestead asks to connect a wallet",
      "path": "/homestead",
      "expectSelector": "[data-empty=\"homestead\"] [data-action=\"connect\"]",
      "expectText": "CONNECT HOMEROOM WALLET"
    },
    {
      "name": "Gear asks to connect a wallet",
      "path": "/gear",
      "expectSelector": "[data-empty=\"gear\"] [data-action=\"connect\"]",
      "expectText": "Connect your wallet to see your Gear."
    },
    {
      "id": "homestead.view",
      "name": "A Homestead shows its level, Creature, locked buildings and empty storage",
      "path": "/homestead/900001",
      "expectSelector": "[data-homestead] [data-homestead-resident]",
      "expectText": "Level 1",
      "visual": true,
      "impact": [
        "public/js/homestead*.js",
        "public/js/screens.js",
        "public/js/app.js",
        "public/js/creature-art.js",
        "lib/homestead.js",
        "styles/**",
        "public/js/work-config.js",
        "lib/work.js"
      ]
    },
    {
      "name": "Buildings other than the Creature's Trade building stay locked",
      "path": "/homestead/900001",
      "expectSelector": "[data-buildings] [data-unlocked=\"false\"] [data-building-status=\"locked\"]",
      "expectText": "Requires future Homestead progression."
    },
    {
      "name": "A new Homestead's storage is empty",
      "path": "/homestead/900001",
      "expectSelector": "[data-storage] [data-storage-used=\"0\"][data-storage-capacity=\"100\"]",
      "expectText": "0 / 100"
    },
    {
      "name": "The Creature's Trade building is available",
      "path": "/homestead/900001",
      "expectSelector": "[data-buildings] [data-unlocked=\"true\"] [data-building-status=\"available\"]",
      "expectText": "works here."
    },
    {
      "name": "A Homestead shows its Creature's Work",
      "path": "/homestead/900001",
      "expectSelector": "[data-homestead] [data-work] [data-work-status] [data-work-id]",
      "expectText": "Work history"
    },
    {
      "name": "A Homestead shows its resources by group",
      "path": "/homestead/900001",
      "expectSelector": "[data-resources] [data-resource-group=\"materials\"] [data-resource=\"crystal\"]",
      "expectText": "Materials"
    },
    {
      "name": "An unknown Homestead number shows not found",
      "path": "/homestead/999999",
      "expectSelector": "[data-empty=\"homestead-missing\"]",
      "expectText": "No Homestead has that number."
    },
    {
      "id": "marketplace.food",
      "name": "Marketplace shows the three foods with prices",
      "path": "/marketplace",
      "expectSelector": "[data-market-foods] [data-food=\"punk-feast\"]",
      "expectText": "60 STEAD",
      "visual": true,
      "impact": [
        "public/js/marketplace.js",
        "public/js/food-config.js",
        "public/js/market-config.js",
        "lib/marketplace.js",
        "public/js/screens.js",
        "styles/**"
      ]
    },
    {
      "name": "Marketplace shows players' Resource listings with their STEAD price and seller",
      "path": "/marketplace",
      "expectSelector": "[data-market-listings] [data-listing][data-listing-resource=\"wood\"] [data-listing-price=\"30\"]",
      "expectText": "Sold by @staging-demo-rival"
    },
    {
      "name": "Collection placeholder",
      "path": "/collection",
      "expectSelector": "[data-empty=\"collection\"]",
      "expectText": "Your collection is empty."
    },
    {
      "id": "nav.my-homestead",
      "name": "MY HOMESTEAD in the menu holds the Creature, Homestead and Collection tabs, with COLLECTION current on /collection",
      "path": "/collection",
      "expectSelector": "[data-mine-tabs] [data-mine-tab=\"collection\"][aria-current=\"page\"]",
      "expectText": "COLLECTION",
      "visual": true,
      "impact": [
        "public/js/app.js",
        "public/js/screens.js",
        "styles/**"
      ]
    },
    {
      "name": "The Gear inventory sits under MY HOMESTEAD's HOMESTEAD tab",
      "path": "/gear",
      "expectSelector": "[data-mine-tabs] [data-mine-tab=\"homestead\"][aria-current=\"page\"]",
      "expectText": "HOMESTEAD"
    },
    {
      "name": "The menu shows MY HOMESTEAD as current on /creature",
      "path": "/creature",
      "expectSelector": "#nav [data-nav-mine][aria-current=\"page\"]",
      "expectText": "MY HOMESTEAD"
    },
    {
      "id": "creature.profile",
      "name": "A Creature's profile shows its name, Gene, stats and Creature ID",
      "path": "/creature/1",
      "expectSelector": "[data-creature-profile] [data-gene]",
      "expectText": "CR-00001",
      "visual": true,
      "impact": [
        "public/js/creature-*.js",
        "public/js/creatures.js",
        "public/js/screens.js",
        "lib/creature*.js",
        "styles/**",
        "public/js/care-config.js",
        "lib/care.js",
        "public/js/gear*.js",
        "lib/gear.js",
        "lib/contest*.js",
        "public/js/contest*.js"
      ]
    },
    {
      "name": "A Creature's profile shows its base stats",
      "path": "/creature/1",
      "expectSelector": "[data-creature-profile] [data-stat=\"luck\"]",
      "expectText": "Personality"
    },
    {
      "name": "A Creature's profile shows its hunger and condition",
      "path": "/creature/1",
      "expectSelector": "[data-creature-profile] [data-hunger-section] [data-condition]",
      "expectText": "HUNGER"
    },
    {
      "name": "A Creature's profile shows base, training and effective stats",
      "path": "/creature/1",
      "expectSelector": "[data-creature-profile] [data-training] [data-effective-stat=\"attack\"]",
      "expectText": "Effective"
    },
    {
      "name": "A Creature's profile shows its Gear slots",
      "path": "/creature/1",
      "expectSelector": "[data-creature-profile] [data-gear-section] [data-gear-slot=\"tool\"] ~ [data-gear-slot=\"accessory\"]",
      "expectText": "ACCESSORY"
    },
    {
      "name": "A Creature's profile shows the Gear layer of every stat",
      "path": "/creature/1",
      "expectSelector": "[data-creature-profile] [data-training-stat=\"luck\"] [data-gear-bonus=\"luck\"]",
      "expectText": "Gear"
    },
    {
      "name": "An unknown Creature ID shows not found",
      "path": "/creature/999999",
      "expectSelector": "[data-empty=\"creature-missing\"]",
      "expectText": "No Creature has that ID."
    },
    {
      "name": "Profile asks to connect a wallet",
      "path": "/profile",
      "expectSelector": "[data-empty=\"profile\"]",
      "expectText": "Connect your wallet to view your profile."
    },
    {
      "name": "Contests asks to connect a wallet",
      "path": "/contests",
      "expectSelector": "[data-empty=\"contests\"] [data-action=\"connect\"]",
      "expectText": "Connect your wallet to compete."
    },
    {
      "id": "contests.result",
      "name": "A finished contest shows its winner, totals and the shared log",
      "path": "/contests/900001",
      "expectSelector": "[data-contest=\"900001\"][data-contest-status=\"COMPLETED\"] [data-contest-log] [data-log-kind=\"win\"]",
      "expectText": "WINNER",
      "visual": true,
      "impact": [
        "public/js/contest*.js",
        "public/js/screens.js",
        "public/js/app.js",
        "lib/contest*.js",
        "styles/**"
      ]
    },
    {
      "name": "An unknown contest number shows not found",
      "path": "/contests/999999",
      "expectSelector": "[data-empty=\"contest-missing\"]",
      "expectText": "No contest has that number."
    },
    {
      "name": "A Creature's profile shows whether it can compete",
      "path": "/creature/1",
      "expectSelector": "[data-creature-profile] [data-contest-section] [data-contest-availability]",
      "expectText": "Contests"
    }
  ]
}
